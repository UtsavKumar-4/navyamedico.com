  let catalog = [];
  let settings = { upiId:'' };

  function finalPrice(p){
    const disc = Number(p.discount) || 0;
    return Math.round(Number(p.mrp) * (1 - disc / 100));
  }

  // ---------- Product catalogue ----------
  const productGrid = document.getElementById('productGrid');

  function renderProducts(){
    if(catalog.length === 0){
      productGrid.innerHTML = '<div class="cart-empty">No medicines listed yet. Shop owner can add them via "Manage medicines" below.</div>';
      return;
    }
    productGrid.innerHTML = catalog.map(p => {
      const price = finalPrice(p);
      const mrpHtml = (p.discount > 0) ? `<span class="p-mrp">₹${p.mrp}</span>` : '';
      const saveHtml = (p.discount > 0) ? `<span class="p-save">${p.discount}% OFF</span>` : '';
      const rxHtml = p.rx ? `<span class="p-rx">Rx required</span>` : '';
      const expHtml = p.expiry ? `<span class="p-exp mono">Exp ${escapeHtml(p.expiry)}</span>` : '';
      const catLabel = { otc:'OTC', prescription:'PRESCRIPTION', ayurvedic:'AYURVEDIC', surgical:'SURGICAL', baby:'BABY CARE' }[p.category] || p.category.toUpperCase();
      return `<div class="product-card" data-category="${p.category}" data-id="${p.id}" data-name="${escapeHtml(p.name)}" data-pack="${escapeHtml(p.pack)}" data-price="${price}">
        <span class="p-cat">${catLabel}</span>
        <h4>${escapeHtml(p.name)}</h4>
        <span class="p-pack">${escapeHtml(p.pack)}</span>
        ${rxHtml}
        <div class="price-row">${mrpHtml}<span class="p-price">₹${price}</span>${saveHtml}</div>
        ${expHtml}
        <div class="p-actions">
          <div class="qty-stepper"><button class="qty-dec">−</button><span class="qty-val">1</span><button class="qty-inc">+</button></div>
          <button class="add-btn">Add</button>
        </div>
      </div>`;
    }).join('');
  }

  async function initCatalogue(){
    catalog = await loadShared('catalog', null);
    if(!catalog){
      catalog = DEFAULT_CATALOG;
      await saveShared('catalog', catalog);
    }
    renderProducts();
    settings = await loadShared('settings', { upiId:'' });
    updateUpiVisibility();
  }
  initCatalogue();

  // ---------- Order catalogue: category filters ----------
  const filterTabs = document.getElementById('filterTabs');
  filterTabs.addEventListener('click', e => {
    const btn = e.target.closest('.filter-tab');
    if(!btn) return;
    filterTabs.querySelectorAll('.filter-tab').forEach(t => t.classList.remove('active'));
    btn.classList.add('active');
    const filter = btn.dataset.filter;
    document.querySelectorAll('#productGrid .product-card').forEach(card => {
      card.style.display = (filter === 'all' || card.dataset.category === filter) ? '' : 'none';
    });
  });

  // ---------- Cart state ----------
  const cart = {};
  const cartFab = document.getElementById('cartFab');
  const cartOverlay = document.getElementById('cartOverlay');
  const cartDrawer = document.getElementById('cartDrawer');
  const cartClose = document.getElementById('cartClose');
  const cartBadge = document.getElementById('cartBadge');
  const cartItemsEl = document.getElementById('cartItems');
  const cartFoot = document.getElementById('cartFoot');
  const upiPayBtn = document.getElementById('upiPayBtn');
  const upiAmountEl = document.getElementById('upiAmount');
  const upiQrToggle = document.getElementById('upiQrToggle');
  const upiQrBox = document.getElementById('upiQrBox');
  const qrAmountEl = document.getElementById('qrAmount');

  function openCart(){ cartDrawer.classList.add('open'); cartOverlay.classList.add('open'); }
  function closeCart(){ cartDrawer.classList.remove('open'); cartOverlay.classList.remove('open'); }
  cartFab.addEventListener('click', openCart);
  cartClose.addEventListener('click', closeCart);
  cartOverlay.addEventListener('click', closeCart);

  function cartTotal(){
    return Object.values(cart).reduce((sum, it) => sum + it.price * it.qty, 0);
  }

  function buildUpiUrl(amount){
    return `upi://pay?pa=${encodeURIComponent(settings.upiId)}&pn=${encodeURIComponent('Navya Medico')}&am=${amount}&cu=INR&tn=${encodeURIComponent('Order from website')}`;
  }

  function renderUpiQr(amount){
    const box = document.getElementById('qrCodeCanvas');
    box.innerHTML = '';
    if(typeof QRCode === 'undefined' || !amount) return;
    new QRCode(box, {
      text: buildUpiUrl(amount),
      width: 200, height: 200,
      colorDark: '#16342A', colorLight: '#ffffff'
    });
    qrAmountEl.textContent = amount;
  }

  function updateUpiVisibility(){
    const total = cartTotal();
    if(settings.upiId && total > 0){
      upiPayBtn.classList.add('visible');
      upiQrToggle.classList.add('visible');
      upiAmountEl.textContent = total;
      if(upiQrBox.style.display === 'block') renderUpiQr(total);
    } else {
      upiPayBtn.classList.remove('visible');
      upiQrToggle.classList.remove('visible');
      upiQrBox.style.display = 'none';
    }
  }

  upiQrToggle.addEventListener('click', () => {
    const opening = upiQrBox.style.display !== 'block';
    upiQrBox.style.display = opening ? 'block' : 'none';
    if(opening) renderUpiQr(cartTotal());
  });

  function renderCart(){
    const items = Object.values(cart);
    cartBadge.textContent = items.reduce((sum, it) => sum + it.qty, 0);

    if(items.length === 0){
      cartItemsEl.innerHTML = '<div class="cart-empty">Your cart is empty. Add medicines to get started.</div>';
      cartFoot.style.display = 'none';
      updateUpiVisibility();
      return;
    }
    cartFoot.style.display = 'block';
    let total = 0;
    const rows = items.map(it => {
      total += it.price * it.qty;
      return `<div class="cart-item" data-id="${it.id}">
        <div class="ci-info">
          <div class="ci-name">${it.name}</div>
          <div class="ci-pack">${it.pack} · ₹${it.price} each</div>
          <div class="qty-stepper" style="margin-top:6px;">
            <button class="ci-dec" aria-label="Decrease quantity">−</button><span class="qty-val">${it.qty}</span><button class="ci-inc" aria-label="Increase quantity">+</button>
          </div>
        </div>
        <div class="ci-right">
          <span class="mono" style="font-size:13px;color:var(--pine);font-weight:600;">₹${it.price * it.qty}</span>
          <button class="ci-remove" title="Remove item" aria-label="Remove item">✕</button>
        </div>
      </div>`;
    }).join('');
    cartItemsEl.innerHTML = rows + `<div class="cart-total"><span>Total</span><span>₹${total}</span></div>`;
    updateUpiVisibility();
  }

  cartItemsEl.addEventListener('click', e => {
    const row = e.target.closest('.cart-item');
    if(!row) return;
    const id = row.dataset.id;
    if(e.target.classList.contains('ci-inc')){
      cart[id].qty = Math.min(cart[id].qty + 1, 50);
    } else if(e.target.classList.contains('ci-dec')){
      cart[id].qty -= 1;
      if(cart[id].qty <= 0) delete cart[id];
    } else if(e.target.classList.contains('ci-remove')){
      delete cart[id];
    }
    renderCart();
  });

  // ---------- Product cards: qty steppers + add to cart ----------
  productGrid.addEventListener('click', e => {
    const card = e.target.closest('.product-card');
    if(!card) return;
    const qtyEl = card.querySelector('.qty-val');
    let qty = parseInt(qtyEl.textContent, 10);

    if(e.target.classList.contains('qty-inc')){
      qtyEl.textContent = Math.min(qty + 1, 50);
    } else if(e.target.classList.contains('qty-dec')){
      qtyEl.textContent = Math.max(qty - 1, 1);
    } else if(e.target.classList.contains('add-btn')){
      const id = card.dataset.id;
      const name = card.dataset.name;
      const pack = card.dataset.pack;
      const price = parseFloat(card.dataset.price);
      if(cart[id]){
        cart[id].qty += qty;
      } else {
        cart[id] = { id, name, pack, price, qty };
      }
      qtyEl.textContent = 1;
      const btn = e.target;
      const original = btn.textContent;
      btn.textContent = 'Added ✓';
      btn.classList.add('added');
      setTimeout(() => { btn.textContent = original; btn.classList.remove('added'); }, 1200);
      renderCart();
    }
  });

  // ---------- Send order on WhatsApp ----------
  document.getElementById('sendOrder').addEventListener('click', () => {
    const items = Object.values(cart);
    if(items.length === 0) return;

    const name = document.getElementById('custName').value.trim();
    const phone = document.getElementById('custPhone').value.trim();
    const address = document.getElementById('custAddress').value.trim();

    if(!name || !phone){
      showToast('Please add your name and phone number so we can confirm your order.', true);
      return;
    }

    let total = 0;
    const lines = items.map(it => {
      total += it.price * it.qty;
      return `• ${it.name} (${it.pack}) x${it.qty} — ₹${it.price * it.qty}`;
    });

    const message =
`New order from website — Navya Medico

${lines.join('\n')}

Total: ₹${total}

Name: ${name}
Phone: ${phone}
Delivery: ${address || 'Not specified — please ask'}`;

    const url = `https://wa.me/919199857464?text=${encodeURIComponent(message)}`;
    window.open(url, '_blank');
  });

  // ---------- Pay via UPI ----------
  upiPayBtn.addEventListener('click', () => {
    const total = cartTotal();
    if(total === 0 || !settings.upiId) return;
    window.location.href = buildUpiUrl(total);
  });

  renderCart();

  // ============================================================
  // ---------- Admin panel ----------
  // ============================================================
  const adminOpenBtn = document.getElementById('adminOpenBtn');
  const adminOverlay = document.getElementById('adminOverlay');
  const adminPanel = document.getElementById('adminPanel');
  const adminCloseBtn = document.getElementById('adminCloseBtn');
  const adminLoginBox = document.getElementById('adminLoginBox');
  const adminMain = document.getElementById('adminMain');
  const adminPassInput = document.getElementById('adminPassInput');
  const adminLoginBtn = document.getElementById('adminLoginBtn');
  const adminLoginError = document.getElementById('adminLoginError');
  const ADMIN_PASSWORD = 'navya2026';
  let adminUnlocked = false;

  function openAdmin(){
    adminOverlay.classList.add('open');
    adminPanel.classList.add('open');
  }
  function closeAdmin(){
    adminOverlay.classList.remove('open');
    adminPanel.classList.remove('open');
  }
  adminOpenBtn.addEventListener('click', openAdmin);
  adminCloseBtn.addEventListener('click', closeAdmin);
  adminOverlay.addEventListener('click', closeAdmin);

  adminLoginBtn.addEventListener('click', () => {
    if(adminPassInput.value === ADMIN_PASSWORD){
      adminUnlocked = true;
      adminLoginBox.style.display = 'none';
      adminMain.style.display = 'block';
      adminLoginError.textContent = '';
      renderMedTable();
      document.getElementById('upiIdInput').value = settings.upiId || '';
    } else {
      adminLoginError.textContent = 'Wrong password, try again.';
    }
  });

  document.querySelectorAll('.admin-tab').forEach(tab => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.admin-tab').forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const target = tab.dataset.atab;
      document.getElementById('adminMedsTab').style.display = (target === 'meds') ? 'block' : 'none';
      document.getElementById('adminPayTab').style.display = (target === 'pay') ? 'block' : 'none';
    });
  });

  // ---- medicine form (add/edit) ----
  const medForm = document.getElementById('medForm');
  const medSaveBtn = document.getElementById('medSaveBtn');
  const medCancelBtn = document.getElementById('medCancelBtn');

  function resetMedForm(){
    medForm.reset();
    document.getElementById('medId').value = '';
    medSaveBtn.textContent = 'Add medicine';
    medCancelBtn.style.display = 'none';
  }

  medCancelBtn.addEventListener('click', resetMedForm);

  medForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('medId').value || ('p' + Date.now());
    const entry = {
      id,
      name: document.getElementById('medName').value.trim(),
      category: document.getElementById('medCategory').value,
      pack: document.getElementById('medPack').value.trim(),
      mrp: parseFloat(document.getElementById('medMrp').value) || 0,
      discount: parseFloat(document.getElementById('medDiscount').value) || 0,
      batch: document.getElementById('medBatch').value.trim(),
      expiry: document.getElementById('medExpiry').value,
      rx: document.getElementById('medRx').checked
    };
    if(!entry.name || entry.mrp <= 0){
      showToast('Please enter at least a medicine name and MRP.', true);
      return;
    }
    const existingIdx = catalog.findIndex(p => p.id === id);
    if(existingIdx >= 0){
      catalog[existingIdx] = entry;
    } else {
      catalog.push(entry);
    }
    const saved = await saveShared('catalog', catalog);
    renderProducts();
    renderMedTable();
    resetMedForm();
    showToast(saved ? 'Medicine saved.' : 'Saved on screen, but could not persist — see note below.', !saved);
  });

  function renderMedTable(){
    const tbody = document.getElementById('medTableBody');
    if(catalog.length === 0){
      tbody.innerHTML = '<tr><td colspan="7" style="color:var(--ink-soft);">No medicines added yet.</td></tr>';
      return;
    }
    tbody.innerHTML = catalog.map(p => {
      const price = finalPrice(p);
      return `<tr data-id="${p.id}">
        <td>${escapeHtml(p.name)}${p.rx ? ' <span class="p-rx" style="margin-left:4px;">Rx</span>' : ''}<br><span style="color:var(--ink-soft);">${escapeHtml(p.pack)}</span></td>
        <td>₹${p.mrp}</td>
        <td>${p.discount || 0}%</td>
        <td>₹${price}</td>
        <td>${escapeHtml(p.batch || '—')}</td>
        <td>${escapeHtml(p.expiry || '—')}</td>
        <td class="mt-actions">
          <button class="mt-edit">Edit</button>
          <button class="mt-delete danger" data-confirm="0">Delete</button>
        </td>
      </tr>`;
    }).join('');
  }

  document.getElementById('medTableBody').addEventListener('click', async (e) => {
    const row = e.target.closest('tr');
    if(!row) return;
    const id = row.dataset.id;
    const item = catalog.find(p => p.id === id);
    if(!item) return;

    if(e.target.classList.contains('mt-edit')){
      document.getElementById('medId').value = item.id;
      document.getElementById('medName').value = item.name;
      document.getElementById('medCategory').value = item.category;
      document.getElementById('medPack').value = item.pack;
      document.getElementById('medMrp').value = item.mrp;
      document.getElementById('medDiscount').value = item.discount;
      document.getElementById('medBatch').value = item.batch;
      document.getElementById('medExpiry').value = item.expiry;
      document.getElementById('medRx').checked = item.rx;
      medSaveBtn.textContent = 'Save changes';
      medCancelBtn.style.display = 'inline-block';
      medForm.scrollIntoView({ behavior:'smooth', block:'start' });
    } else if(e.target.classList.contains('mt-delete')){
      if(e.target.dataset.confirm !== '1'){
        e.target.dataset.confirm = '1';
        e.target.textContent = 'Tap again';
        clearTimeout(e.target._resetTimer);
        e.target._resetTimer = setTimeout(() => {
          e.target.dataset.confirm = '0';
          e.target.textContent = 'Delete';
        }, 3000);
        return;
      }
      catalog = catalog.filter(p => p.id !== id);
      const saved = await saveShared('catalog', catalog);
      renderProducts();
      renderMedTable();
      showToast(saved ? 'Medicine removed.' : 'Removed on screen, but could not persist.', !saved);
    }
  });

  // ---- payment settings ----
  document.getElementById('saveUpiBtn').addEventListener('click', async () => {
    const upiId = document.getElementById('upiIdInput').value.trim();
    settings.upiId = upiId;
    const ok = await saveShared('settings', settings);
    updateUpiVisibility();
    showToast(ok ? 'UPI ID saved. The "Pay via UPI" button will now show for customers.' : 'Could not save — please try again.', !ok);
  });

</script>

</body>
</html>
