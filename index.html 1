    t._timer = setTimeout(() => t.classList.remove('show'), 3200);
  }

  async function loadShared(key, fallback){
    try{
      if(window.storage){
        const res = await window.storage.get(key, true);
        return res ? JSON.parse(res.value) : fallback;
      }
      throw new Error('window.storage not available');
    }catch(err){
      try{
        const raw = localStorage.getItem('nm_' + key);
        return raw ? JSON.parse(raw) : fallback;
      }catch(err2){
        return fallback;
      }
    }
  }
  async function saveShared(key, value){
    let ok = false;
    try{
      if(window.storage){
        await window.storage.set(key, JSON.stringify(value), true);
        ok = true;
      }
    }catch(err){
      console.error('window.storage save failed, falling back to localStorage', err);
    }
    try{
      localStorage.setItem('nm_' + key, JSON.stringify(value));
      ok = true;
    }catch(err2){
      console.error('localStorage save failed', err2);
    }
    return ok;
  }

