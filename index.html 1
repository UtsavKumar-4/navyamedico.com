<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Navya Medico — Wholesale &amp; Retail Chemist</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,500;0,9..144,600;0,9..144,700;1,9..144,500&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --pine:#16342A;
    --pine-light:#2B5940;
    --paper:#F6F5EF;
    --paper-deep:#EEECE2;
    --amber:#D98A2B;
    --amber-deep:#B56E1B;
    --ink:#1C1E1B;
    --ink-soft:#4A4D46;
    --foil:#E1E7DD;
    --foil-line:#C9D4C4;
    --white:#FFFDF9;
    --radius:14px;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--paper);
    color:var(--ink);
    font-family:'Inter',sans-serif;
    line-height:1.6;
    overflow-x:hidden;
  }
  h1,h2,h3{font-family:'Fraunces',serif;font-weight:600;color:var(--pine);letter-spacing:-0.01em;}
  .mono{font-family:'IBM Plex Mono',monospace;}
  a{color:inherit;text-decoration:none;}
  img{max-width:100%;display:block;}
  .wrap{max-width:1120px;margin:0 auto;padding:0 24px;}

  /* ---------- header ---------- */
  header{
    position:sticky;top:0;z-index:50;
    background:rgba(246,245,239,0.92);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--foil-line);
  }
  .nav{display:flex;align-items:center;justify-content:space-between;padding:16px 24px;max-width:1120px;margin:0 auto;}
  .brand{display:flex;align-items:center;gap:10px;}
  .rx-mark{
    width:38px;height:38px;border-radius:50%;
    background:var(--pine);color:var(--white);
    display:flex;align-items:center;justify-content:center;
    font-family:'Fraunces',serif;font-weight:700;font-size:19px;
    flex-shrink:0;
  }
  .brand-text{display:flex;flex-direction:column;line-height:1.15;}
  .brand-text .name{font-family:'Fraunces',serif;font-weight:700;font-size:20px;color:var(--pine);}
  .brand-text .sub{font-size:11px;letter-spacing:0.08em;text-transform:uppercase;color:var(--ink-soft);}
  nav.links{display:flex;gap:28px;font-size:14.5px;font-weight:500;}
  nav.links a{color:var(--ink-soft);border-bottom:2px solid transparent;padding-bottom:3px;transition:color .15s, border-color .15s;}
  nav.links a:hover{color:var(--pine);border-color:var(--amber);}
  .call-btn{
    background:var(--amber);color:var(--white);
    padding:10px 20px;border-radius:100px;font-size:14px;font-weight:600;
    display:flex;align-items:center;gap:8px;white-space:nowrap;
    transition:background .15s;
  }
  .call-btn:hover{background:var(--amber-deep);}
  .menu-toggle{display:none;background:none;border:none;font-size:26px;color:var(--pine);cursor:pointer;}

  /* ---------- hero ---------- */
  .hero{position:relative;padding:76px 24px 40px;overflow:hidden;}
  .hero-inner{max-width:1120px;margin:0 auto;display:grid;grid-template-columns:1.1fr 0.9fr;gap:48px;align-items:center;}
  .label-tag{
    display:inline-flex;align-items:center;gap:8px;
    background:var(--white);border:1px solid var(--foil-line);
    padding:6px 14px 6px 10px;border-radius:100px;
    font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--pine-light);
    margin-bottom:22px;
    box-shadow:0 1px 0 rgba(0,0,0,0.03);
  }
  .label-tag .dot{width:7px;height:7px;border-radius:50%;background:var(--amber);}
  .hero h1{font-size:clamp(38px,5vw,58px);line-height:1.04;margin-bottom:20px;}
  .hero h1 em{font-style:italic;color:var(--amber-deep);}
  .hero p.lead{font-size:17px;color:var(--ink-soft);max-width:480px;margin-bottom:30px;}
  .hero-ctas{display:flex;gap:14px;flex-wrap:wrap;margin-bottom:36px;}
  .btn-primary,.btn-secondary{
    padding:13px 24px;border-radius:100px;font-weight:600;font-size:14.5px;
    display:inline-flex;align-items:center;gap:9px;
  }
  .btn-primary{background:var(--pine);color:var(--white);transition:background .15s;}
  .btn-primary:hover{background:var(--pine-light);}
  .btn-secondary{background:transparent;color:var(--pine);border:1.5px solid var(--pine);transition:background .15s,color .15s;}
  .btn-secondary:hover{background:var(--pine);color:var(--white);}

  /* blister strip - signature element */
  .blister-strip{display:flex;gap:6px;flex-wrap:wrap;}
  .pocket{
    background:var(--foil);
    border:1px solid var(--foil-line);
    border-radius:11px;
    padding:9px 14px;
    display:flex;align-items:center;gap:8px;
    font-size:12.5px;font-weight:500;color:var(--pine-light);
    position:relative;
  }
  .pocket .pill{
    width:9px;height:9px;border-radius:50%;
    background:var(--amber);flex-shrink:0;
  }

  .hero-art{position:relative;display:flex;justify-content:center;align-items:center;}
  .strip-card{
    background:var(--white);
    border:1px solid var(--foil-line);
    border-radius:20px;
    padding:26px;
    width:100%;max-width:340px;
    box-shadow:0 18px 40px -22px rgba(22,52,42,0.35);
  }
  .strip-card .strip-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;}
  .strip-card .strip-head span{font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--ink-soft);}
  .capsule-row{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-bottom:14px;}
  .capsule{
    aspect-ratio:1/1.5;
    background:linear-gradient(180deg,var(--foil) 50%, var(--white) 50%);
    border:1px solid var(--foil-line);
    border-radius:9px;
    position:relative;
  }
  .capsule::after{
    content:'';position:absolute;inset:0;
    border-radius:9px;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,0.4);
  }
  .strip-foot{font-size:12px;color:var(--ink-soft);border-top:1px dashed var(--foil-line);padding-top:12px;}
  .strip-foot b{color:var(--pine);}

  /* ---------- order / catalogue ---------- */
  .order-toolbar{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;margin-bottom:28px;}
  .filter-tabs{display:flex;gap:8px;flex-wrap:wrap;}
  .filter-tab{
    padding:8px 16px;border-radius:100px;border:1px solid var(--foil-line);background:var(--white);
    font-size:13px;font-weight:500;color:var(--ink-soft);cursor:pointer;transition:background .15s,color .15s,border-color .15s;
    font-family:'Inter',sans-serif;
  }
  .filter-tab.active{background:var(--pine);color:var(--white);border-color:var(--pine);}
  .filter-tab:hover:not(.active){border-color:var(--pine-light);color:var(--pine);}
  .product-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .product-card{
    background:var(--white);border:1px solid var(--foil-line);border-radius:var(--radius);
    padding:20px;display:flex;flex-direction:column;gap:8px;transition:box-shadow .15s, border-color .15s;
  }
  .product-card:hover{border-color:var(--pine-light);box-shadow:0 14px 26px -20px rgba(22,52,42,0.4);}
  .product-card .p-cat{font-family:'IBM Plex Mono',monospace;font-size:10.5px;text-transform:uppercase;color:var(--amber-deep);letter-spacing:0.05em;}
  .product-card h4{font-size:16.5px;color:var(--ink);font-weight:600;font-family:'Inter',sans-serif;}
  .product-card .p-pack{font-size:12.5px;color:var(--ink-soft);}
  .product-card .p-rx{
    font-size:10.5px;color:var(--amber-deep);background:#FBF1E2;border:1px dashed #E8C48A;
    padding:3px 8px;border-radius:6px;display:inline-block;width:fit-content;
  }
  .product-card .p-price{font-family:'IBM Plex Mono',monospace;font-size:15px;color:var(--pine);font-weight:600;margin-top:auto;padding-top:4px;}
  .p-actions{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-top:6px;}
  .qty-stepper{display:flex;align-items:center;border:1px solid var(--foil-line);border-radius:8px;overflow:hidden;}
  .qty-stepper button{width:28px;height:28px;background:var(--paper);border:none;font-size:16px;cursor:pointer;color:var(--pine);}
  .qty-stepper span{width:26px;text-align:center;font-size:13px;font-family:'IBM Plex Mono',monospace;}
  .add-btn{
    background:var(--pine);color:var(--white);border:none;border-radius:100px;padding:8px 16px;
    font-size:13px;font-weight:600;cursor:pointer;transition:background .15s;font-family:'Inter',sans-serif;
  }
  .add-btn:hover{background:var(--pine-light);}
  .add-btn.added{background:var(--amber-deep);}
  .order-note{font-size:12.5px;color:var(--ink-soft);background:var(--foil);border:1px solid var(--foil-line);border-radius:10px;padding:14px 16px;margin-top:28px;}
  .price-row{display:flex;align-items:baseline;gap:8px;flex-wrap:wrap;margin-top:auto;padding-top:4px;}
  .p-mrp{font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--ink-soft);text-decoration:line-through;}
  .p-save{font-size:10.5px;font-weight:700;color:var(--amber-deep);background:#FBF1E2;border-radius:6px;padding:2px 6px;}
  .p-exp{font-size:10.5px;color:var(--ink-soft);}

  /* ---------- admin panel ---------- */
  .admin-link{background:none;border:none;color:var(--ink-soft);font-size:12px;cursor:pointer;text-decoration:underline;opacity:0.6;}
  .admin-overlay{position:fixed;inset:0;background:rgba(22,30,26,0.55);z-index:110;display:none;}
  .admin-overlay.open{display:block;}
  .admin-panel{
    position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);
    width:92%;max-width:640px;max-height:86vh;overflow-y:auto;
    background:var(--white);border-radius:16px;z-index:120;display:none;
    box-shadow:0 30px 60px -20px rgba(0,0,0,0.35);
  }
  .admin-panel.open{display:block;}
  .admin-head{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;border-bottom:1px solid var(--foil-line);position:sticky;top:0;background:var(--white);}
  .admin-head h3{font-size:17px;}
  .admin-body{padding:22px;}
  .admin-body input,.admin-body select{
    width:100%;padding:10px 12px;border:1px solid var(--foil-line);border-radius:9px;font-size:13.5px;
    margin-bottom:10px;font-family:'Inter',sans-serif;background:var(--paper);color:var(--ink);
  }
  .admin-body label{font-size:12px;color:var(--ink-soft);display:block;margin-bottom:4px;}
  .admin-row2{display:grid;grid-template-columns:1fr 1fr;gap:10px;}
  .admin-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;}
  .admin-save-btn{background:var(--pine);color:var(--white);border:none;padding:11px 20px;border-radius:100px;font-weight:600;font-size:13.5px;cursor:pointer;}
  .admin-save-btn:hover{background:var(--pine-light);}
  .admin-tabs{display:flex;gap:8px;margin-bottom:18px;}
  .admin-tab{padding:7px 14px;border-radius:100px;border:1px solid var(--foil-line);background:var(--white);font-size:12.5px;font-weight:500;color:var(--ink-soft);cursor:pointer;}
  .admin-tab.active{background:var(--pine);color:var(--white);border-color:var(--pine);}
  .med-table{width:100%;border-collapse:collapse;font-size:12.5px;margin-top:18px;}
  .med-table th{text-align:left;color:var(--ink-soft);font-weight:500;font-size:11px;text-transform:uppercase;letter-spacing:0.03em;padding:6px 8px;border-bottom:1px solid var(--foil-line);}
  .med-table td{padding:8px;border-bottom:1px solid var(--foil-line);vertical-align:top;}
  .med-table .mt-actions button{background:none;border:none;cursor:pointer;font-size:13px;margin-right:8px;color:var(--pine-light);}
  .med-table .mt-actions button.danger{color:var(--amber-deep);}
  .admin-error{color:var(--amber-deep);font-size:12.5px;margin-top:6px;}
  .admin-note{font-size:11.5px;color:var(--ink-soft);margin-top:10px;}
  .upi-btn{
    width:100%;background:var(--pine);color:#fff;border:none;padding:13px;border-radius:100px;
    font-weight:600;font-size:14.5px;cursor:pointer;display:none;align-items:center;justify-content:center;
    gap:8px;font-family:'Inter',sans-serif;margin-bottom:10px;transition:background .15s;
  }
  .upi-btn.visible{display:flex;}
  .upi-btn:hover{background:var(--pine-light);}
  .upi-qr-toggle{
    width:100%;background:transparent;color:var(--pine);border:1.5px solid var(--pine);
    padding:11px;border-radius:100px;font-weight:600;font-size:13.5px;cursor:pointer;
    display:none;align-items:center;justify-content:center;gap:8px;margin-bottom:10px;
    font-family:'Inter',sans-serif;transition:background .15s,color .15s;
  }
  .upi-qr-toggle.visible{display:flex;}
  .upi-qr-toggle:hover{background:var(--pine);color:#fff;}
  .upi-qr-box{
    background:var(--paper);border:1px solid var(--foil-line);border-radius:12px;
    padding:16px;text-align:center;margin-bottom:10px;
  }
  .upi-qr-box #qrCodeCanvas{display:flex;justify-content:center;margin-bottom:10px;}
  .qr-note{font-size:12px;color:var(--ink-soft);}
  .toast{
    position:fixed;bottom:90px;right:22px;max-width:300px;
    background:var(--pine);color:#fff;padding:12px 18px;border-radius:10px;
    font-size:13.5px;box-shadow:0 10px 24px -10px rgba(0,0,0,0.4);z-index:200;
    opacity:0;transform:translateY(10px);pointer-events:none;transition:opacity .2s, transform .2s;
  }
  .toast.show{opacity:1;transform:translateY(0);}
  .toast.error{background:var(--amber-deep);}

  /* ---------- cart FAB + drawer ---------- */
  .cart-fab{
    position:fixed;bottom:22px;right:22px;background:var(--pine);color:var(--white);border:none;
    border-radius:100px;padding:14px 20px;display:flex;align-items:center;gap:10px;font-weight:600;
    font-size:14px;box-shadow:0 12px 30px -12px rgba(22,52,42,0.55);cursor:pointer;z-index:80;
    font-family:'Inter',sans-serif;
  }
  .cart-fab:hover{background:var(--pine-light);}
  .cart-fab .badge{
    background:var(--amber);color:var(--white);border-radius:50%;min-width:20px;height:20px;
    display:flex;align-items:center;justify-content:center;font-size:11px;font-family:'IBM Plex Mono',monospace;padding:0 4px;
  }
  .cart-overlay{position:fixed;inset:0;background:rgba(22,30,26,0.45);z-index:90;display:none;}
  .cart-overlay.open{display:block;}
  .cart-drawer{
    position:fixed;top:0;right:-420px;width:100%;max-width:400px;height:100%;background:var(--white);
    z-index:95;transition:right .25s ease;display:flex;flex-direction:column;box-shadow:-10px 0 40px rgba(0,0,0,0.15);
  }
  .cart-drawer.open{right:0;}
  .cart-head{display:flex;justify-content:space-between;align-items:center;padding:20px 22px;border-bottom:1px solid var(--foil-line);}
  .cart-head h3{font-size:18px;}
  .cart-close{background:none;border:none;font-size:22px;cursor:pointer;color:var(--ink-soft);}
  .cart-items{flex:1;overflow-y:auto;padding:14px 22px;}
  .cart-empty{text-align:center;color:var(--ink-soft);font-size:13.5px;padding:44px 10px;}
  .cart-item{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;padding:12px 0;border-bottom:1px dashed var(--foil-line);}
  .cart-item .ci-info{min-width:0;}
  .cart-item .ci-name{font-size:13.5px;font-weight:500;color:var(--ink);}
  .cart-item .ci-pack{font-size:11.5px;color:var(--ink-soft);}
  .cart-item .ci-right{display:flex;align-items:center;gap:10px;flex-shrink:0;}
  .cart-item .ci-remove{background:none;border:none;color:var(--amber-deep);font-size:16px;cursor:pointer;line-height:1;}
  .cart-foot{padding:16px 22px 22px;border-top:1px solid var(--foil-line);}
  .cart-foot input,.cart-foot textarea{
    width:100%;padding:10px 12px;border:1px solid var(--foil-line);border-radius:9px;font-size:13.5px;
    margin-bottom:10px;font-family:'Inter',sans-serif;background:var(--paper);color:var(--ink);
  }
  .cart-foot input:focus,.cart-foot textarea:focus{outline:2px solid var(--pine-light);outline-offset:1px;}
  .whatsapp-btn{
    width:100%;background:#25D366;color:#fff;border:none;padding:13px;border-radius:100px;
    font-weight:600;font-size:14.5px;cursor:pointer;display:flex;align-items:center;justify-content:center;
    gap:8px;font-family:'Inter',sans-serif;transition:background .15s;
  }
  .whatsapp-btn:hover{background:#1FB855;}
  .cart-foot .rx-note{font-size:11px;color:var(--ink-soft);margin-top:10px;text-align:center;}
  .cart-total{display:flex;justify-content:space-between;align-items:center;padding:14px 0 6px;font-weight:700;color:var(--pine);font-size:15.5px;font-family:'IBM Plex Mono',monospace;}

  /* ---------- section shared ---------- */
  section{padding:64px 24px;}
  .eyebrow{
    font-family:'IBM Plex Mono',monospace;font-size:12px;letter-spacing:0.06em;
    text-transform:uppercase;color:var(--amber-deep);margin-bottom:10px;display:block;
  }
  .section-head{max-width:600px;margin-bottom:44px;}
  .section-head h2{font-size:clamp(28px,3.4vw,38px);}
  .section-head p{color:var(--ink-soft);font-size:15.5px;margin-top:10px;}

  /* ---------- about ---------- */
  .about{background:var(--white);border-top:1px solid var(--foil-line);border-bottom:1px solid var(--foil-line);}
  .about-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
  .about-card{
    background:var(--paper);border:1px solid var(--foil-line);border-radius:var(--radius);
    padding:30px 28px;
  }
  .about-card .tag{
    display:inline-block;background:var(--pine);color:var(--white);font-size:11px;
    font-family:'IBM Plex Mono',monospace;padding:4px 10px;border-radius:100px;margin-bottom:16px;
  }
  .about-card.retail .tag{background:var(--amber);}
  .about-card h3{font-size:22px;margin-bottom:10px;}
  .about-card p{color:var(--ink-soft);font-size:14.5px;margin-bottom:16px;}
  .about-card ul{list-style:none;font-size:14px;color:var(--ink);}
  .about-card ul li{display:flex;gap:9px;padding:6px 0;border-top:1px solid var(--foil-line);}
  .about-card ul li:first-child{border-top:none;}
  .about-card ul li::before{content:'—';color:var(--amber-deep);flex-shrink:0;}

  /* ---------- categories (blister grid) ---------- */
  .cat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;}
  .cat-card{
    background:var(--white);border:1px solid var(--foil-line);border-radius:var(--radius);
    padding:24px 22px;transition:transform .18s, box-shadow .18s, border-color .18s;
  }
  .cat-card:hover{transform:translateY(-3px);box-shadow:0 16px 30px -20px rgba(22,52,42,0.4);border-color:var(--pine-light);}
  .cat-icon{
    width:44px;height:44px;border-radius:10px;background:var(--foil);
    display:flex;align-items:center;justify-content:center;margin-bottom:16px;font-size:20px;
  }
  .cat-card h3{font-size:17px;margin-bottom:6px;font-family:'Inter',sans-serif;font-weight:600;color:var(--ink);}
  .cat-card p{font-size:13.5px;color:var(--ink-soft);}

  /* ---------- why / stats ---------- */
  .why{background:var(--pine);color:var(--white);border-radius:24px;margin:0 24px;}
  .why-inner{max-width:1120px;margin:0 auto;padding:60px 24px;}
  .why .section-head h2{color:var(--white);}
  .why .section-head p{color:#CFE0D6;}
  .stat-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;margin-top:8px;}
  .stat{border-left:2px solid var(--amber);padding-left:16px;}
  .stat .num{font-family:'Fraunces',serif;font-size:36px;font-weight:600;color:var(--white);}
  .stat .label{font-size:13px;color:#CFE0D6;margin-top:4px;}

  /* ---------- hours & location ---------- */
  .hours-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px;}
  .info-card{background:var(--white);border:1px solid var(--foil-line);border-radius:var(--radius);padding:28px;}
  .info-card h3{font-size:18px;margin-bottom:16px;color:var(--pine);}
  .hours-row{display:flex;justify-content:space-between;font-size:14px;padding:9px 0;border-top:1px dashed var(--foil-line);}
  .hours-row:first-of-type{border-top:none;}
  .hours-row .day{color:var(--ink-soft);}
  .hours-row .time{font-family:'IBM Plex Mono',monospace;color:var(--ink);}
  .addr-line{display:flex;gap:10px;font-size:14.5px;color:var(--ink-soft);margin-bottom:12px;align-items:flex-start;}
  .addr-line > span:last-child{min-width:0;overflow-wrap:anywhere;}
  .addr-line b{color:var(--ink);}
  .edit-note{
    font-size:12px;color:var(--amber-deep);background:#FBF1E2;border:1px dashed #E8C48A;
    padding:8px 12px;border-radius:8px;margin-top:14px;
  }

  /* ---------- contact ---------- */
  .contact-wrap{display:grid;grid-template-columns:0.9fr 1.1fr;gap:32px;}
